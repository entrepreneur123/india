<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The brand orange (ui/Components.kt Brand.Saffron): the launcher icon, the notification tint. -->
    <color name="brand_saffron">#FFEA6A00</color>

    <style name="Theme.Yaari" parent="android:Theme.Material.Light.NoActionBar">
        <!-- White behind the first frame, with dark status and navigation icons, like the app. -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
